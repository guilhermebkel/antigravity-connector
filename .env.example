# Copy this file to .env and change API_KEY. The server stops at startup when a value is invalid.
# API_KEY is the bearer token every client sends (at least 24 characters). Keep it out of git.
API_KEY=change-me


# Container settings. The image listens on all interfaces; docker-compose.yml publishes the port on 127.0.0.1 only.
HOST=0.0.0.0
ALLOW_NON_LOOPBACK_BIND=true
PORT=8787

# The agy binary and its timeout per call, in milliseconds.
AGY_BIN=agy
AGY_TIMEOUT_MS=300000

# How long a call may wait in the queue before it is refused, in milliseconds.
QUEUE_MAX_WAIT_MS=120000

# The directory of the call log (calls.sqlite). The image uses /data on its own volume.
DATA_DIR=data

# Daily limits per run kind (UTC day). 0 refuses every call of that kind.
DAILY_LIMIT_CHAT=200
DAILY_LIMIT_SEARCH=50
DAILY_LIMIT_IMAGE=20
DAILY_LIMIT_RESEARCH=5
DAILY_LIMIT_BROWSE=20

# Requests per minute, for failed authentications and for valid requests.
HTTP_MAX_REQUESTS_PER_MINUTE=120

# Public origin of this server (optional). With it, create_upload_link returns the full upload URL.
# PUBLIC_URL=https://connector.your-domain.com

# MCP sessions: how many may be open, and how long one may stay idle (milliseconds).
MCP_MAX_SESSIONS=8
MCP_SESSION_TTL_MS=1800000
