{
  "name": "@antigravity-connector/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "API_KEY=local-dev-only-key-0123456789 AGY_BIN=\"$PWD/../../packages/agy/src/Testing/FakeAgy.mjs\" tsx src/main.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "cycles": "dpdm --no-warning --no-tree --exit-code circular:1 --transform --tsconfig tsconfig.json \"src/**/*.ts\""
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@antigravity-connector/tooling": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.173",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@antigravity-connector/api": "workspace:*",
    "@antigravity-connector/core": "workspace:*",
    "@antigravity-connector/mcp": "workspace:*",
    "@antigravity-connector/protocol": "workspace:*",
    "fastify": "^5.12.8"
  }
}
